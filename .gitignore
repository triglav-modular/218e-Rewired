# Tracked: everything needed to build and flash our custom firmware.
# Ignored: everything else.

# --- machine-specific settings ---
config/local.toml

# --- build artifacts (regenerated by tools/build.py) ---
build/

# --- vendor material we do not use ---
# Buchla's Windows flashing kit (we flash from macOS) and its redistributables.
windows/
# Stock firmware images for other models/versions.
otherfirmware/
# Buchla's original updater and its docs — kept out so the experimental
# updater is never confused with the factory one.
ProgramLEM218.command
Buchla 218 Firmware Flashing Guide.pdf
changelog.txt

# --- firmware images ---
# No firmware image is distributed from this repository.
#
# The factory image is Buchla's, and is not ours to redistribute; you already
# have it if you have the official flashing kit.  The patched image is that
# same firmware with our patches spliced in, so it is not ours to redistribute
# either.  What this repository ships is the recipe: put your own factory
# image at the path in config/218e.toml and build.
firmware/*.hex

# Diagnostic updater, rebuilt on demand alongside the latch-probe image.
ProgramLEM218_LatchProbe.command

# --- captures, logs, scratch ---
LEM218_PressureReadout_*.csv
*_fwflash_log.txt
*_analysis/
ghidra_project/
*.gpr
*.rep/

# --- hardware working files ---
# Photoshop scan of the pressure op-amp section (~81 MB).
PRESSURE_OPAMP.psd

.DS_Store

# Python bytecode
__pycache__/
*.pyc

# Never let a firmware image sit in the served web directory.
web/*.hex
