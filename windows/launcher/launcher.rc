// The banana, and the fields Properties shows.  Resource id 1 for the icon:
// Explorer takes the group icon with the lowest id as the file's face.
1 ICON "AppIcon.ico"

1 VERSIONINFO
FILEVERSION    1,0,0,0
PRODUCTVERSION 1,0,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription",  "218e Rewired Flasher"
      VALUE "ProductName",      "218e Rewired"
      VALUE "FileVersion",      "1.0.0.0"
      VALUE "ProductVersion",   "1.0.0.0"
      VALUE "OriginalFilename", "218e Rewired Flasher.exe"
      VALUE "CompanyName",      "Triglav Modular"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
